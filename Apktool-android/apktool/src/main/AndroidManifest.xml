<?xml version='1.0' encoding='utf-8'?>
<manifest
	xmlns:android="http://schemas.android.com/apk/res/android"
	package="com.a4455jkjh.apktool">
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
	<uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
	<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
	<uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES"/>
	<uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
	<uses-permission android:name="android.permission.SET_WALLPAPER"/>
	<application
		android:name=".ApktoolApplication"
		android:icon="@mipmap/apktool"
		android:largeHeap="true"
		android:label="@string/app_name"
		android:theme="@style/AppThemeLight"
		android:resizeableActivity="true">
		<activity
			android:name=".MainActivity"
			android:exported="true"
			android:launchMode="singleTask"
			android:configChanges="orientation|screenSize|keyboardHidden"
			android:label="@string/app_name"
			android:windowSoftInputMode="adjustResize">
			<intent-filter>
				<action android:name="android.intent.action.MAIN"/>
				<category android:name="android.intent.category.LAUNCHER"/>
				<category android:name="android.intent.category.HOME"/>
				<category android:name="android.intent.category.DEFAULT"/>
			</intent-filter> 
		</activity>
<activity
android:name=".AppDrawerActivity"
android:exported="false"
android:label="@string/app_name"/>
<activity
android:name=".InstallApkActivity"
android:exported="false"
android:label="@string/install_app"/>
<activity
android:name=".WallpaperActivity"
android:exported="false"
android:label="@string/launcher_wallpaper"/>
		<provider
			android:name="com.a4455jkjh.apktool.FileProvider"
			android:exported="false"
			android:authorities="com.a4455jkjh.fileprovider"
			android:grantUriPermissions="true"/>
	</application>
</manifest>
