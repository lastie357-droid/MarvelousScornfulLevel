        android:top="7dp">
        <shape android:shape="oval">
            <size android:width="4dp" android:height="4dp" />
            <solid android:color="@color/launcher_text" />
        </shape>
    </item>
    <item
        android:gravity="center_horizontal"
        android:top="18dp">
        <shape android:shape="oval">
            <size android:width="4dp" android:height="4dp" />
            <solid android:color="@color/launcher_text" />
        </shape>
    </item>
    <item
        android:gravity="center_horizontal|bottom"
        android:bottom="7dp">
        <shape android:shape="oval">
            <size android:width="4dp" android:height="4dp" />
            <solid android:color="@color/launcher_text" />
        </shape>
    </item>
</layer-list>