<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="@color/master_card_pressed" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="@color/master_card" />
            <stroke android:width="1dp" android:color="@color/master_border" />
        </shape>
    </item>
</selector>