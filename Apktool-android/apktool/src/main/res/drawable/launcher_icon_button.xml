<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="@color/launcher_surface_pressed" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="@color/launcher_surface" />
            <stroke android:width="1dp" android:color="@color/launcher_border" />
        </shape>
    </item>
</selector>