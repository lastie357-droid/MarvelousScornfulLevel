<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/master_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp"
        android:background="@color/browser_toolbar">

        <Button
            android:id="@+id/browser_home"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/browser_button"
            android:contentDescription="@string/browser_home"
            android:text="⌂"
            android:textColor="@color/master_text"
            android:textSize="24sp" />

        <AutoCompleteTextView
            android:id="@+id/browser_address"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="4dp"
            android:background="@drawable/browser_address"
            android:hint="@string/browser_address_hint"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:singleLine="true"
            android:textColor="@color/master_text"
            android:textColorHint="@color/master_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/browser_refresh"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginLeft="2dp"
            android:background="@drawable/browser_button"
            android:contentDescription="@string/browser_refresh"
            android:text="↻"
            android:textColor="@color/master_text"
            android:textSize="22sp" />

        <Button
            android:id="@+id/browser_new_tab"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/browser_button"
            android:contentDescription="@string/browser_new_tab"
            android:text="+"
            android:textColor="@color/master_text"
            android:textSize="25sp" />

        <Button
            android:id="@+id/browser_tab_count"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/browser_button"
            android:contentDescription="@string/browser_tabs"
            android:text="@string/browser_tabs"
            android:textColor="@color/master_text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/browser_menu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/browser_button"
            android:contentDescription="@string/browser_menu"
            android:text="⋮"
            android:textColor="@color/master_text"
            android:textSize="25sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:background="@color/browser_toolbar">

        <Button
            android:id="@+id/browser_back"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:contentDescription="@string/browser_back"
            android:text="‹  Back"
            android:textSize="14sp" />

        <Button
            android:id="@+id/browser_forward"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:contentDescription="@string/browser_forward"
            android:text="Forward  ›"
            android:textSize="14sp" />

        <Button
            android:id="@+id/browser_zoom"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:contentDescription="@string/browser_zoom"
            android:text="Zoom"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/browser_webview_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/white" />
</LinearLayout>