<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/launcher_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="22dp"
        android:paddingTop="18dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/launcher_text"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/master_home_subtitle"
                android:textColor="@color/launcher_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/launcher_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="⋮"
            android:textColor="@color/launcher_text"
            android:textSize="30sp"
            android:contentDescription="@string/launcher_menu_title"
            android:background="@drawable/launcher_icon_button" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/launcher_hero">

                <TextView
                    android:id="@+id/launcher_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your apps, ready."
                    android:textColor="@color/launcher_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/launcher_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/launcher_muted"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/launcher_default"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/launcher_primary_button"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:text="@string/launcher_default"
                    android:textAllCaps="false"
                    android:textColor="@color/launcher_primary_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/launcher_search"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/launcher_search"
                android:hint="@string/launcher_search_hint"
                android:inputType="text"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:singleLine="true"
                android:textColor="@color/launcher_text"
                android:textColorHint="@color/launcher_muted"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/launcher_apps"
                    android:textColor="@color/launcher_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/launcher_sort_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A–Z"
                    android:textColor="@color/launcher_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/launcher_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:textColor="@color/launcher_muted"
                android:textSize="15sp"
                android:visibility="gone" />

            <GridLayout
                android:id="@+id/launcher_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:columnCount="3"
                android:useDefaultMargins="false" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>