<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/master_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_container_title"
            android:textColor="@color/master_text"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/app_container_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/master_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/app_container_setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/master_button"
            android:text="@string/app_container_setup"
            android:textColor="@color/master_button_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/app_container_open_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/master_button_secondary"
            android:text="@string/app_container_open_profile"
            android:textColor="@color/master_text" />

        <TextView
            android:id="@+id/app_container_profile_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/app_container_profile_note"
            android:textColor="@color/master_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/app_container_manager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/app_container_clone_heading"
                android:textColor="@color/master_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/app_container_package"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/app_container_package_hint"
                android:inputType="text"
                android:singleLine="true"
                android:text="com.whatsapp"
                android:textColor="@color/master_text"
                android:textColorHint="@color/master_muted" />

            <Button
                android:id="@+id/app_container_clone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/master_button"
                android:text="@string/app_container_clone"
                android:textColor="@color/master_button_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/app_container_installed_heading"
                android:textColor="@color/master_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ListView
                android:id="@+id/app_container_apps"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="6dp"
                android:background="@color/master_card"
                android:divider="@color/master_border"
                android:dividerHeight="1dp" />
        </LinearLayout>

        <Button
            android:id="@+id/app_container_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/master_button_secondary"
            android:text="@string/return_master_home"
            android:textColor="@color/master_text" />
    </LinearLayout>
</ScrollView>