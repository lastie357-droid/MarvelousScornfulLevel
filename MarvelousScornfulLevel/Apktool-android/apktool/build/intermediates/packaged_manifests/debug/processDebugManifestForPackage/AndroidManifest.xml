            android:exported="false"
            android:label="@string/install_app" />
        <activity
            android:name="com.a4455jkjh.apktool.WallpaperActivity"
            android:exported="false"
            android:label="@string/launcher_wallpaper" />

        <provider
            android:name="com.a4455jkjh.apktool.FileProvider"
            android:authorities="com.a4455jkjh.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
