<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="#A2E9FF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="14dp" />
            <gradient android:angle="0" android:startColor="@color/launcher_accent" android:endColor="#9C8BFF" />
        </shape>
    </item>
</selector>