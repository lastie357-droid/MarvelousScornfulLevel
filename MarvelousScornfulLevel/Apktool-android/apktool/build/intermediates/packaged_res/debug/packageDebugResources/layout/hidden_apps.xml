<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/launcher_background"
    android:paddingLeft="18dp"
    android:paddingTop="18dp"
    android:paddingRight="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/hidden_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/launcher_text"
            android:textSize="34sp"
            android:background="@drawable/launcher_icon_button"
            android:contentDescription="@string/return_master_home" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hidden_apps_title"
                android:textColor="@color/launcher_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hidden_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/launcher_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <EditText
        android:id="@+id/hidden_search"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/launcher_search"
        android:hint="@string/launcher_search_hint"
        android:inputType="text"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:singleLine="true"
        android:textColor="@color/launcher_text"
        android:textColorHint="@color/launcher_muted"
        android:textSize="15sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hidden_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:gravity="center"
                android:text="@string/hidden_apps_empty"
                android:textColor="@color/launcher_muted"
                android:textSize="15sp"
                android:visibility="gone" />

            <GridLayout
                android:id="@+id/hidden_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:useDefaultMargins="false" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>